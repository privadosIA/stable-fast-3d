<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StableFast3D</RootNamespace>
    <!-- Allows running on machines that only have a newer runtime (e.g. .NET 10). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed API; the native backend comes from Directory.Build.props -->
    <PackageReference Include="TorchSharp" Version="$(TorchSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MusicGenCoreDir)/src/MusicGen.Core/MusicGen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StableFast3D.Net.Tests" />
  </ItemGroup>

</Project>
